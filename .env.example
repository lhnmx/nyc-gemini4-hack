# ==============================================================================
# CraftPOV — Environment Configuration Template
# Copy this file to `.env` and fill in your hackathon team's shared API keys.
# ==============================================================================

# --- Google DeepMind / Gemini 4 API ---
GEMINI_API_KEY=

# Gemini 4 Model Routing (update slugs to match exact NYC Hackathon model IDs)
GEMINI_MODEL_ARGON=gemini-4-argon
GEMINI_MODEL_CARBON=gemini-4-carbon
GEMINI_MODEL_NEON=gemini-4-neon
GEMINI_MODEL_HYDROGEN=gemini-4-hydrogen

# Decisions API (https://aistudio.google.com/docs/changelog?e=0#11-11-2026)
GEMINI_DECISIONS_ENABLED=true
GEMINI_DECISIONS_MODEL=gemini-decision-1
GEMINI_DECISIONS_API_VERSION=v1beta

# Narrated POV film. Set POV_MEDIA_MODE=illustrated_frames to render still-image chapters.
POV_MEDIA_MODE=motion
POV_VIDEO_MODEL=gemini-omni-1.2-flash
POV_IMAGE_MODEL=gemini-3.1-flash-image
AUDIO_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Aoede

# Optional legacy model settings
VEO_MODEL=veo-3.0-generate-preview
IMAGEN_MODEL=imagen-3.0-generate-002

# --- YouTube Discovery ---
YOUTUBE_API_KEY=

# --- Shopify Commerce (shop.dev / Storefront MCP) ---
# Example: https://your-store.myshopify.com/api/mcp
SHOPIFY_MCP_URL=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_SHOP_DOMAIN=

# --- App & Storage ---
APP_HOST=0.0.0.0
APP_PORT=8000
MEDIA_OUTPUT_DIR=./outputs
SQLITE_PATH=./data/craftpov.sqlite3

# Vercel API and rendering daemon use the same Turso SQLite database and public Blob store.
# Keep these values server-side and use separate storage for each environment.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
